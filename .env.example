# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Authentication Secrets
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long
SESSION_INACTIVITY_MINUTES=15

# Super Admin Initial Seed (used by scripts/seed-super-admin.ts)
SUPER_ADMIN_EMAIL=admin@viralplugmedia.com
SUPER_ADMIN_PASSWORD=SuperSecretAdmin2026!
SUPER_ADMIN_NAME=Super Admin

# Razorpay Configuration
RAZORPAY_KEY_ID=rzp_test_xxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxx

# Storage / Cloudflare R2
NEXT_PUBLIC_R2_BUCKET_URL=https://assets.viralplugmedia.com
